# Copy this file to .env and fill in the secrets/values needed for the
# lesson note generator service.
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# MongoDB connection (when present the service can insert into the main site's DB)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/lernex?retryWrites=true&w=majority
MONGO_URI=
# Optional: target database name (defaults to the DB name in the URI)
MONGO_DB=lernex

# OpenAI / OpenAI-compatible keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (can proxy Gemini or other models)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL_MAIN=

# Groq provider (optional)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL_MAIN=
# If you want to disable Groq even when key is present set this to true.
BLOCK_GROQ=true

# Service runtime and behavior
PORT=8001
# When ONLY_MONGO=true the service will skip local SQL storage and write only to MongoDB
ONLY_MONGO=true

# Logging level: debug|info|warning|error
LOG_LEVEL=info
